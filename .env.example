# Copy to .env.local (local) or add in Vercel → Settings → Environment Variables.

# Where form submissions are sent: a Google Apps Script web-app URL
# (see scripts/google-apps-script.gs) or a Formspree endpoint.
FORMS_ENDPOINT=

# Optional. With a YouTube Data API v3 key the site pulls the latest uploads,
# view counts and subscriber numbers automatically (refreshed hourly).
# Without it, the site uses src/content/videos.json (refresh with `npm run sync:videos`).
YOUTUBE_API_KEY=

# Keystatic content editor (/keystatic). Locally it just works and edits files.
# For editing on the live site, Keystatic saves to GitHub instead:
#   1. Set the repo below, run `npm run dev`, open /keystatic and follow the
#      "Create GitHub App" steps. Keystatic writes the next four values into .env.local.
#   2. Copy all five into Vercel's environment variables.
# Your GitHub repo as owner/name, e.g. aditya1156/refactorslife
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
